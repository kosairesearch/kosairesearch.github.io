rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 워치리스트: 본인(uid)만 자기 문서를 읽고 쓸 수 있음
    match /watchlists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 회원 문서 — 가입 동의 기록이 들어간다.
    //
    // 읽기는 본인에게만 연다. 남의 동의 기록을 볼 수 있으면 안 되고,
    // 마케팅 수신 여부는 그 자체가 개인정보다.
    //
    // 쓰기는 아무에게도 열지 않는다. 전부 Cloud Functions 를 거친다
    // (recordSignupConsent · setMarketingConsent · deleteAccount).
    // Admin SDK 는 이 규칙을 지나가므로 서버는 그대로 쓴다.
    //
    // 왜 닫았나. 동의 기록은 나중에 "이 사람이 언제 무엇에 동의했는가" 를
    // 답해야 하는 자료다. 그런데 본인 쓰기를 열어 두면 브라우저 콘솔을 열
    // 수 있는 사람은 누구나 age14 나 agreedAt 이나 marketing 을 고칠 수
    // 있다. 당사자가 고칠 수 있는 기록은 아무것도 증명하지 못한다.
    //
    // 값도 서버가 정한다. 클라이언트가 함수에 보내는 것은 선택 항목인
    // 마케팅 수신 여부 하나뿐이고, 판 번호·필수 항목·시각은 서버가 박는다.
    //
    // 탈퇴하면 이 문서도 지운다 — 동의 화면에서 "보유 기간: 회원 탈퇴
    // 시까지" 라고 알리고 받았으므로, 남겨 두면 그 약속을 어기는 것이다.
    // deleteAccount 가 지운다.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 동의 이력 — 추가만 되는 기록. 아무에게도 열지 않는다.
    //
    // users/{uid}.consents 는 '지금 상태' 라서, 마케팅을 켰다 껐다 하면
    // 앞의 기록이 사라진다. 실제로 그렇게 덮어쓰고 있었다. 분쟁이 나면
    // 우리가 입증해야 하는 자료인데 스스로 지우고 있던 셈이다.
    //
    // 그래서 이력을 따로 두되, 읽기까지 막는다. 본인이 읽을 이유가 없고
    // (설정 화면은 users 문서로 충분하다) 남이 읽을 이유는 더 없다.
    // 조회는 관리자 함수(adminConsentLookup)가 Admin SDK 로 한다.
    match /consentEvents/{id} {
      allow read, write: if false;
    }

    // 제공자 갱신 토큰 — 탈퇴할 때 네이버 연결을 끊는 데만 쓴다.
    //
    // 아무에게도 열지 않는다. 본인에게도 열지 않는다. users 문서는 설정
    // 화면이 마케팅 수신 여부를 읽어야 해서 본인 읽기를 열어 두었는데,
    // 자격증명을 거기 두면 브라우저 콘솔로 그대로 새어 나간다. 그래서
    // 자리를 따로 뒀다.
    //
    // 쓰기는 socialLogin, 읽기와 삭제는 deleteAccount 가 Admin SDK 로 한다.
    match /providerTokens/{uid} {
      allow read, write: if false;
    }

  }
}
