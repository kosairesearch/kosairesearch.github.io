{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],

  "//": "firestore.rules 는 여기 적혀 있어야 배포된다. 이게 빠져 있어서 저장소의 규칙과 실제 규칙이 갈라져 있었다 — users 컬렉션을 열어 줬는데 실사이트에서는 계속 거부됐다.",
  "firestore": {
    "rules": "firestore.rules"
  }
}
